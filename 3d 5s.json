el=false; detach();}});\n355: addEventListener('contextmenu',e=>e.preventDefault());\n356: \n357: function viewDir(){\n358:   const east=new THREE.Vector3().crossVectors(new THREE.Vector3(0,0,1),UP).normalize();\n359:   const north=new THREE.Vector3().crossVectors(UP,east).normalize();\n360:   return north.clone().multiplyScalar(Math.cos(pitch)*Math.cos(yaw))\n361:     .addScaledVector(east, Math.cos(pitch)*Math.sin(yaw))\n362:     .addScaledVector(UP, Math.sin(pitch)).normalize();\n363: }\n364: function tryAttach(h){\n365:   if(!h) return false;\n366:   const upDist = h.point.clone().sub(P.pos).dot(UP);\n367:   if(h.distance < MAX_ROPE && upDist > 3){\n368:     P.attached=true; P.anchor.copy(h.point); P.ropeLen=Math.min(h.distance,MAX_ROPE);\n369:     anchorBall.visible=true; anchorBall.position.copy(h.point);\n370:     ropeLine.visible=true;\n371:     return true;\n372:   }\n373:   return false;\n374: }\n375: function nearestHit(){\n376:   let h = null;\n377:   for(const t of tilesList){\n378:     const hits = ray.intersectObject(t.group, true);\n379:     if(hits.length && (!h || hits[0].distance < h.distance)) h = hits[0];\n380:   }\n381:   if(!h){\n382:     // フォールバック街や地面にも引っ掛けられるように全シーンで再試行\n383:     const hits2 = ray.intersectObjects(scene.children.filter(o=>o!==ropeLine&&o!==anchorBall&&o!==hero), true);\n384:     if(hits2.length) h = hits2[0];\n385:   }\n386:   return h;\n387: }\n388: function shoot(){\n389:   ray.setFromCamera(new THREE.Vector2(0,0), camera);\n390:   tryAttach(nearestHit());\n391: }\n392: function autoShoot(fwd){\n393:   _t1.copy(P.pos).addScaledVector(fwd,60).addScaledVector(UP,30);\n394:   ray.set(P.pos,_t1.sub(P.pos).normalize());\n395:   tryAttach(nearestHit());\n396: }\n397: function detach(boost=1.6){\n398:   if(!P.attached) return;\n399:   P.attached=false; anchorBall.visible=false; ropeLine.visible=false;\n400:   P.vel.multiplyScalar(boost).addScaledVector(UP,12);\n401: }\n402: function respawn(){ P.pos.copy(SPAWN); P.vel.set(0,0,0); detach(); P.attached=false; ropeLine.visible=false; anchorBall.visible=false; }\n403: addEventListener('pointerdown',e=>{ if((!started&&!window.__started)||e.target.closest('#card'))return; if(e.button===2){detach();} else if(e.button===0){ holdReel=true; holdTimer=0; shoot(); } });\n404: addEventListener('pointerup',e=>{ if(e.button===0){ holdReel=false; detach(); } });\n405: // タッチ: 長押し=糸+加速、離す=ジャンプ、ドラッグ=視点\n406: let lastTX=0;\n407: addEventListener('touchstart',e=>{ if(!started&&!window.__started) return; holdReel=true; holdTimer=0; shoot(); lastTX=e.touches[0].clientX; },{passive:true});\n408: addEventListener('touchmove',e=>{ if(!started&&!window.__started) return; const x=e.touches[0].clientX; yaw-=(x-lastTX)*0.005; lastTX=x; },{passive:true});\n409: addEventListener('touchend',()=>{ holdReel=false; detach(); });\n410: addEventListener('mousemove',e=>{\n411:   if(!document.pointerLockElement) return;\n412:   yaw -= e.movementX*0.0022; pitch -= e.movementY*0.0022;\n413:   pitch = THREE.MathUtils.clamp(pitch,-1.2,1.2);\n414: });\n415: \n416: function stepPlayer(dt){\n417:   const fwd = viewDir();\n418:   const sp = P.vel.length();\n419:   P.vel.addScaledVector(UP,-GRAV*dt);\n420:   P.vel.multiplyScalar(Math.max(0,1-0.04*dt));\n421:   const right=new THREE.Vector3().crossVectors(fwd,UP).normalize();\n422:   if(P.attached && keys['KeyW']) P.ropeLen=Math.max(12,P.ropeLen-16*dt);\n423:   if(P.attached && keys['KeyS']) P.ropeLen=Math.min(MAX_ROPE,P.ropeLen+16*dt);\n424:   if(keys['KeyW']&&!P.attached) P.vel.addScaledVector(fwd,60*dt);\n425:   if(keys['KeyS']&&!P.attached) P.vel.addScaledVector(fwd,-10*dt);\n426:   if(keys['KeyA']) P.vel.addScaledVector(right,-40*dt);\n427:   if(keys['KeyD']) P.vel.addScaledVector(right,40*dt);\n428:   if(!P.attached && fwd.dot(UP) < -0.25) P.vel.addScaledVector(fwd,(keys['KeyW']?90:20)*dt); // ダイブ加速\n429:   P.pos.addScaledVector(P.vel,dt);\n430:   const hAbove=P.pos.clone().sub(ORIGIN).dot(UP);\n431: \n432:   // 長押し=巻取り / オート=勝手に糸を掛け直す\n433:   if(holdReel){\n434:     if(P.attached) P.ropeLen=Math.max(10,P.ropeLen-30*dt);\n435:     else { holdTimer-=dt; if(holdTimer<=0){ holdTimer=0.15; shoot(); } }\n436:   }\n437:   autoTimer-=dt;\n438:   if(autoMode && !P.attached && !holdReel && hAbove>8 && sp>4 && autoTimer<=0){ autoTimer=0.4; autoShoot(fwd); }\n439: \n440:   if(P.attached){\n441:     const d=P.pos.clone().sub(P.anchor); const dist=d.length();\n442:     if(dist>P.ropeLen){\n443:       const n=d.divideScalar(dist||1);\n444:       P.pos.copy(P.anchor).addScaledVector(n,P.ropeLen);\n445:       const vOut=P.vel.dot(n);\n446:       if(vOut>0) P.vel.addScaledVector(n,-vOut);\n447:       P.vel.addScaledVector(fwd,22*dt); // ポンプ加速\n448:     }\n449:     if(P.pos.distanceTo(P.anchor)>MAX_ROPE*1.2) detach(1);\n450:   }\n451:   if(hAbove<MIN_H){ P.pos.addScaledVector(UP,MIN_H-hAbove);\n452:     const vUp=P.vel.dot(UP); if(vUp<0)P.vel.addScaledVector(UP,-vUp*1.6); P.vel.multiplyScalar(0.96); }\n453:   // ヒーロー向き・ポーズ\n454:   hero.position.copy(P.pos);\n455:   if(sp>2){ _t1.copy(P.pos).add(P.vel); hero.lookAt(_t1); }\n456:   poseHero(P.attached?'swing':(sp>20&&fwd.dot(UP)<-0.25)?'dive':'cruise');\n457:   if(P.attached){ _t1.copy(P.pos).addScaledVector(UP,1.15); ropeLine.geometry.setFromPoints([_t1,P.anchor]); }\n458: \n459:   // カメラ追従 + FOV演出 + 振動\n460:   const want=P.pos.clone().addScaledVector(fwd,-7).addScaledVector(UP,3);\n461:   camera.position.lerp(want,1-Math.pow(0.0005,dt));\n462:   _sh.copy(P.pos).addScaledVector(fwd,14).addScaledVector(P.vel,0.2);\n463:   const shk=Math.min(1,sp/55)*0.4;\n464:   if(shk>0.01){ _sh.addScaledVector(right,(Math.random()-0.5)*shk).addScaledVector(UP,(Math.random()-0.5)*shk); }\n465:   camera.lookAt(_sh);\n466:   speedEl.style.opacity=THREE.MathUtils.clamp((sp-16)/45,0,0.85).toFixed(2);\n467:   const tFov=THREE.MathUtils.clamp(62+sp*0.7,62,100);\n468:   camera.fov+=(tFov-camera.fov)*Math.min(1,dt*4); camera.updateProjectionMatrix();\n469:   // HUD + 照準色\n470:   const kmh=Math.round(sp*3.6);\n471:   document.getElementById('stat').textContent=`速度 ${kmh}km/h 高度 ${Math.round(hAbove)}m ${P.attached?('ロープ '+Math.round(P.ropeLen)+'m'):'送電線なし — ビルを狙ってクリック'}`;\n472:   document.getElementById('cross').className = P.attached?'ok':'';\n473: }\n474: \n475: // 照準アシスト: 中央にビルがあれば照準を赤く\n476: let started=false;\n477: function hideStartHint(){}\n478: document.getElementById('go').onclick=()=>{\n479:   document.getElementById('start').style.display='none';\n480:   started=true; window.__started=true; renderer.domElement.requestPointerLock?.();\n481:   camera.position.copy(P.pos.clone().addScaledVector(viewDir(),-10).addScaledVector(UP,4));\n482: };\n483: renderer.domElement.addEventListener('click',()=>{ if(started) renderer.domElement.requestPointerLock?.(); });\n484: \n485: const clock=new THREE.Clock();\n486: (function loop(){\n487:   requestAnimationFrame(loop);\n488:   const dt=Math.min(clock.getDelta(),0.05);\n489:   for(const t of tilesList){\n490:     t.setCamera(camera); t.setResolutionFromRenderer(camera,renderer);\n491:     camera.updateMatrixWorld(); t.update();\n492:   }\n493:   if(started||window.__started) stepPlayer(dt);\n494:   else { // 開始前は京都駅をゆっくり周回\n495:     const t=performance.now()*0.0001;\n496:     camera.position.copy(lonLatToEcef(34.99+t*0.002%0.02,135.758,300));\n497:     camera.lookAt(lonLatToEcef(34.994,135.758,50));\n498:   }\n499:   updateStreet(dt);\n500:   // 照準チェック (1秒に5回だけ)\n501:   renderer.render(scene,camera);\n502: })();\n503: </script>\n504: </body>\n505: </html>\n\n(End of file - total 505 lines)\n</content>",
