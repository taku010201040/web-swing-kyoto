            "input": {
              "content": "import * as THREE from 'three';\nimport { LocalFrame } from './geo';\nimport { FRAME_LAT, FRAME_LON, PHYS, SPAWN, COURSE, PLATEAU_CREDIT } from './config';\nimport { City } from './city';\nimport { Street } from './street';\nimport { Course } from './course';\nimport { Ninja } from './ninja';\nimport { Player } from './player';\nimport { GameHud } from './hud';\nimport { GameAudio } from './audio';\n\ntype State = 'loading' | 'title' | 'playing' | 'result';\n\nconst BEST_KEY = 'kaginawa-kyoto-best-v1';\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });\nrenderer.setSize(window.innerWidth, window.innerHeight);\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\nrenderer.outputColorSpace = THREE.SRGBColorSpace;\ndocument.body.appendChild(renderer.domElement);\nrenderer.domElement.id = 'game-canvas';\n\nconst scene = new THREE.Scene();\nconst camera = new THREE.PerspectiveCamera(62, window.innerWidth / window.innerHeight, 0.5, 400000);\n\nconst frame = new LocalFrame(FRAME_LAT, FRAME_LON, 0);\nconst env = new THREE.Group();\nframe.applyToObject(env);\nscene.add(env);\ncamera.userData.canvas = renderer.domElement;\n\nconst hud = new GameHud();\nconst audio = new GameAudio();\nconst statusMessages: string[] = [];\n\nconst city = new City(frame, camera, renderer, (s) => {\n  if (s.usingFallback && s.tilesetsLive === 0) {\n    setStatus(`PLATEAU: 応答待ち (建物 ${s.plateauBuildings}件)`);\n  } else if (s.tilesetsLive > 0) {\n    setStatus(`PLATEAU 京都市LOD2: 建物 ${s.plateauBuildings}件表示中 ${PLATEAU_CREDIT.split(':')[0]}`);\n  }\n}, scene);\nenv.add(city.group);\n\nconst street = new Street();\nenv.add(street.group);\nstreet.setNight(true, scene);\n\nconst ninja = new Ninja();\nenv.add(ninja.group);\n\nconst course = new Course(frame);\nenv.add(course.group);\n\nconst state: {\n  phase: State;\n  time: number;\n  score: number;\n  coins: number;\n  combo: number;\n  falls: number;\n  best: number | null;\n  startAt: number;\n} = {\n  phase: 'loading',\n  time: 0,\n  score: 0,\n  coins: 0,\n  combo: 0,\n  falls: 0,\n  best: readBest(),\n  startAt: 0,\n};\n\nconst gateCenters = COURSE.map((c) => frame.geo(c.lat, c.lon, c.h));\nconst spawnPos = frame.geo(SPAWN.lat, SPAWN.lon, SPAWN.h);\n\nconst player = new Player(frame, env, ninja, camera, () => city.raycasterTargets(), {\n  onCheckpoint: (index, label, goal) => {\n    if (goal) {\n      finishRun();\n      return;\n    }\n    state.score += 2000;\n    player.setCheckpoint(gateCenters[index]);\n    audio.checkpoint();\n    hud.banner(`⛩ ${label}を制覇! +2000`, 'gold');\n  },\n  onCoins: (count) => {\n    state.coins += count;\n    state.score += count * 100;\n    for (let i = 0; i < count; i++) {\n      window.setTimeout(() => audio.coin(), i * 60);\n    }\n  },\n  onFall: () => {\n    state.falls += 1;\n    state.time += PHYS.fallPenalty;\n    state.combo = 0;\n    audio.fall();\n    hud.banner('転倒! +3.00秒', 'danger');\n  },\n  onRestart: () => startRun(),\n  onToggleDayNight: () => {\n    const night = street.toggle(scene);\n    hud.banner(night ? '夜 — 京都の光' : '昼 — 鴨川の朝', 'cyan');\n  },\n  onDash: (x, y, z) => {\n    audio.dash();\n    spawnPuff(x, y, z);\n  },\n  onAttach: (x, y, z) => {\n    state.combo = Math.min(9, state.combo + 1);\n    audio.attach();\n    player.spawnImpact(x, y, z);\n  },\n});\nplayer.reset();\n\nfunction readBest(): number | null {\n  const v = localStorage.getItem(BEST_KEY);\n  const n = v ? Number(v) : NaN;\n  return Number.isFinite(n) ? n : null;\n}\n\nfunction saveBest(t: number): boolean {\n  const isRecord = state.best === null || t < state.best;\n  if (isRecord) {\n    state.best = t;\n    localStorage.setItem(BEST_KEY, String(t));\n  }\n  return isRecord;\n}\n\nfunction formatTime(t: number): string {\n  const m = Math.floor(t / 60);\n  const s = t - m * 60;\n  return `${m}:${s.toFixed(2).padStart(5, '0')}`;\n}\n\nfunction setStatus(s: string): void {\n  statusMessages.length = 0;\n  hud.setStatus(s);\n}\n\nconst puffGroup = new THREE.Group();\nenv.add(puffGroup);\nconst puffs: { m: THREE.Mesh; life: number }[] = [];\n\nfunction spawnPuff(x: number, y: number, z: number): void {\n  const m = new THREE.Mesh(\n    new THREE.SphereGeometry(1, 10, 8),\n    new THREE.MeshBasicMaterial({ color: 0xcfd6e4, transparent: true, opacity: 0.7, depthWrite: false }),\n  );\n  m.position.set(x, y - 1, z);\n  m.scale.setScalar(1.5);\n  puffGroup.add(m);\n  puffs.push({ m, life: 0.6 });\n}\n\nfunction startRun(): void {\n  hud.hideResult();\n  course.reset();\n  state.phase = 'playing';\n  state.time = 0;\n  state.score = 0;\n  state.coins = 0;\n  state.combo = 0;\n  state.falls = 0;\n  state.startAt = performance.now();\n  player.reset();\n  player.setPlaying(true);\n  hud.showHud();\n  hud.banner('任務開始! 四条烏丸 → 京都駅', 'gold');\n  audio.init();\n  audio.startMusic();\n  document.exitPointerLock?.();\n  void renderer.domElement.requestPointerLock?.();\n  const p = city.probeFinished;\n  void p;\n}\n\nfunction finishRun(): void {\n  if (state.phase !== 'playing') return;\n  state.phase = 'result';\n  player.setPlaying(false);\n  const elapsed = state.time;\n  const speedBonus = Math.max(0, Math.round(20000 - elapsed * 200));\n  state.score += 2000 + speedBonus;\n  const record = saveBest(elapsed);\n  audio.goal();\n  document.exitPointerLock?.();\n  hud.showResult({\n    time: elapsed,\n    score: state.score,\n    coins: state.coins,\n    total: courseCoinsTotal,\n    record,\n    best: formatTime(state.best ?? elapsed),\n  });\n}\n\nlet courseCoinsTotal = 0;\n\nasync function boot(): Promise<void> {\n  hud.setLoading(0.08, 'PLATEAU tileset を確認中…');\n  await city.settle();\n  city.createTiles();\n  window.setTimeout(() => {\n    if (state.phase === 'loading') {\n      hud.setLoading(1, city.isFallbackActive ? 'PLATEAU未取得 → 予備の京都を生成しました' : '読込完了');\n      hud.hideLoading();\n      showTitle();\n    }\n  }, 1200);\n}\n\nlet titleShown = false;\nfunction showTitle(): void {\n  if (titleShown) return;\n  titleShown = true;\n  state.phase = 'title';\n  hud.hideLoading();\n  hud.showTitle();\n}\n\nhud.bindStart(() => {\n  showTitle();\n  startRun();\n});\nhud.bindRetry(() => startRun());\n\nconst clock = new THREE.Clock();\nlet elapsedAll = 0;\nconst tmpV = new THREE.Vector3();\nconst previewTarget = frame.geo(35.0, 135.7590, 90);\n\nfunction loop(): void {\n  requestAnimationFrame(loop);\n  const dt = Math.min(clock.getDelta(), 0.05);\n  elapsedAll += dt;\n\n  city.update(dt);\n  street.update(dt);\n  puffsUpdate(dt);\n\n  if (state.phase === 'playing') {\n    state.time = (performance.now() - state.startAt) / 1000;\n    player.update(dt);\n    const res = course.update(dt, elapsedAll, player.pos);\n    if (res.coinCount > 0) {\n      state.coins += res.coinCount;\n      state.score += res.coinCount * 100;\n      audio.coin();\n    }\n    if (res.hitGate !== null) {\n      const g = course.gate(res.hitGate);\n      player.setCheckpoint(gateCenters[res.hitGate]);\n      state.score += 2000;\n      audio.checkpoint();\n      hud.banner(`⛩ ${g.label}${g.goal ? '到着!' : 'を制覇! +2000'}`, 'gold');\n      if (g.goal) finishRun();\n    }\n    street.updateWind(dt, player.pos, player.vel, player.viewDir(tmpV), player.speed > 8);\n    audio.setSpeed(player.speed);\n\n    const nextIdx = course.nextGateIndex(player.pos, 0);\n    const nextGate = course.gate(nextIdx);\n    hud.setStats({\n      speed: player.speed,\n      alt: player.pos.y,\n      time: state.time,\n      coins: state.coins,\n      total: courseCoinsTotal,\n      combo: state.combo,\n      next: nextGate.label,\n      nextDist: player.pos.distanceTo(nextGate.center),\n      falls: state.falls,\n      best: state.best !== null ? formatTime(state.best) : '--:--.--',\n      dashReady: 1 - player.dashRatio,\n    });\n  } else if (state.phase === 'title' || state.phase === 'loading') {\n    const t = elapsedAll * 0.08;\n    const r = 620;\n    const c = previewTarget;\n    camera.position.set(\n      c.x + Math.sin(t) * r,\n      c.y + 190 + Math.sin(t * 0.7) * 60,\n      c.z + Math.cos(t) * r,\n    );\n    camera.up.set(0, 1, 0);\n    camera.lookAt(c);\n    camera.fov = 60;\n    camera.updateProjectionMatrix();\n    street.updateWind(dt, camera.position, tmpV.set(0, 0, 0), tmpV, false);\n  }\n\n  renderer.render(scene, camera);\n}\n\nfunction puffsUpdate(dt: number): void {\n  for (let i = puffs.length - 1; i >= 0; i--) {\n    const p = puffs[i];\n    p.life -= dt;\n    p.m.scale.multiplyScalar(1 + dt * 4);\n    (p.m.material as THREE.MeshBasicMaterial).opacity = Math.max(0, p.life);\n    if (p.life <= 0) {\n      puffGroup.remove(p.m);\n      p.m.geometry.dispose();\n      (p.m.material as THREE.Material).dispose();\n      puffs.splice(i, 1);\n    }\n  }\n}\n\naddEventListener('resize', () => {\n  camera.aspect = window.innerWidth / window.innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(window.innerWidth, window.innerHeight);\n});\n\naddEventListener('keydown', (e) => {\n  if (e.code === 'Enter') {\n    if (state.phase === 'title') startRun();\n    else if (state.phase === 'result') startRun();\n  }\n});\n\nvoid boot();\nloop();\n",
