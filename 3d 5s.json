new THREE.Mesh(new THREE.PlaneGeometry(0.5,0.35),tl); t.position.set(s,0.9,-2.32); t.rotation.y=Math.PI; g.add(t);\n251:   }\n252:   g.position.copy(ORIGIN).addScaledVector(eastA,lane).addScaledVector(northA,-1300+Math.random()*2600).addScaledVector(UP,0.2);\n253:   g.up.copy(UP); g.lookAt(g.position.clone().addScaledVector(northA,dir));\n254:   scene.add(g);\n255:   cars.push({g,dir,speed:9+Math.random()*8});\n256: }\n257: \n258: // 風パーティクル (速度で可視化)\n259: const WIND_N=350;\n260: const windGeo=new THREE.BufferGeometry();\n261: { const arr=new Float32Array(WIND_N*3), c0=ORIGIN.clone().addScaledVector(UP,130);\n262:   for(let i=0;i<WIND_N;i++){ arr[i*3]=c0.x+(Math.random()-0.5)*90; arr[i*3+1]=c0.y+(Math.random()-0.5)*90; arr[i*3+2]=c0.z+(Math.random()-0.5)*90; }\n263:   windGeo.setAttribute('position',new THREE.BufferAttribute(arr,3)); }\n264: const wind=new THREE.Points(windGeo,new THREE.PointsMaterial({color:0xcfe6ff,size:0.55,transparent:true,opacity:0,depthWrite:false,blending:THREE.AdditiveBlending}));\n265: wind.frustumCulled=false; scene.add(wind);\n266: \n267: const _t1=new THREE.Vector3(), _sh=new THREE.Vector3();\n268: const speedEl=document.getElementById('speed');\n269: function updateStreet(dt){\n270:   for(const c of cars){\n271:     c.g.position.addScaledVector(northA,c.dir*c.speed*dt);\n272:     const along=c.g.position.clone().sub(ORIGIN).dot(northA);\n273:     if(along>1350||along<-1350) c.g.position.addScaledVector(northA,-Math.sign(along)*2700);\n274:   }\n275:   const sp=P.vel.length(), wm=wind.material;\n276:   if((!started&&!window.__started)||sp<8){ wm.opacity=Math.max(0,wm.opacity-dt*2); return; }\n277:   wm.opacity=Math.min(0.7,(sp-8)/50);\n278:   const f0=viewDir(), arr=windGeo.attributes.position.array;\n279:   _t1.copy(P.vel).multiplyScalar(dt*0.9);\n280:   for(let i=0;i<WIND_N;i++){\n281:     const j=i*3;\n282:     arr[j]-=_t1.x; arr[j+1]-=_t1.y; arr[j+2]-=_t1.z;\n283:     const dx=arr[j]-P.pos.x, dy=arr[j+1]-P.pos.y, dz=arr[j+2]-P.pos.z;\n284:     if(dx*dx+dy*dy+dz*dz>45*45){\n285:       const r=15+Math.random()*25;\n286:       arr[j]=P.pos.x+f0.x*r+(Math.random()-0.5)*30;\n287:       arr[j+1]=P.pos.y+f0.y*r+(Math.random()-0.5)*30;\n288:       arr[j+2]=P.pos.z+f0.z*r+(Math.random()-0.5)*30;\n289:     }\n290:   }\n291:   windGeo.attributes.position.needsUpdate=true;\n292: }\n293: \n294: function applyMode(){\n295:   scene.background.set(night?0x060a18:0x87ceeb);\n296:   scene.fog.color.set(night?0x060a18:0x87ceeb);\n297:   hemi.intensity=night?0.5:1.3; sun.intensity=night?0.7:1.6;\n298:   sun.color.set(night?0x8fb0ff:0xffffff);\n299:   stars.visible=night; moon.visible=night;\n300:   ground.material.color.set(night?0x14171e:0x2f3336);\n301: }\n302: applyMode();\n303: \n304: // ===== 2. プレイヤー + スイング物理 =====\n305: const SPAWN = lonLatToEcef(34.9965, 135.7585, 130); // 四条烏丸上空\n306: const P = { pos:SPAWN.clone(), vel:new THREE.Vector3(), attached:false, anchor:new THREE.Vector3(), ropeLen:0 };\n307: const GRAV=26, MAX_ROPE=260, MIN_H=2;\n308: const ray = new THREE.Raycaster(); ray.far=800;\n309: if('firstHitOnly' in ray) ray.firstHitOnly = true;\n310: \n311: const suitM=new THREE.MeshStandardMaterial({color:0x7d0d1d,roughness:.55,metalness:.1});\n312: const darkM=new THREE.MeshStandardMaterial({color:0x15151c,roughness:.6});\n313: const eyeM=new THREE.MeshBasicMaterial({color:0xf2f6ff});\n314: function limb(r,len,mat){\n315:   const g=new THREE.Group();\n316:   const m=new THREE.Mesh(new THREE.CapsuleGeometry(r,len,4,10),mat);\n317:   m.position.y=-(len/2+r);\n318:   g.add(m); return g;\n319: }\n320: const hero=new THREE.Group(); hero.up.copy(UP);\n321: const torsoH=new THREE.Mesh(new THREE.CapsuleGeometry(0.32,0.62,4,12),suitM);\n322: torsoH.position.y=0.55; hero.add(torsoH);\n323: const headH=new THREE.Mesh(new THREE.SphereGeometry(0.26,18,14),darkM);\n324: headH.position.y=1.28; hero.add(headH);\n325: for(const s of [-1,1]){\n326:   const eye=new THREE.Mesh(new THREE.SphereGeometry(0.09,10,8),eyeM);\