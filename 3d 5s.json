                "text": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n<title>WebSwing Kyoto - PLATEAU スパイダーマン風スイング</title>\n<style>\n  html,body{margin:0;height:100%;overflow:hidden;background:#87ceeb;font-family:system-ui,sans-serif}\n  canvas{display:block}\n  #hud{position:fixed;top:10px;left:10px;color:#fff;background:#0008;padding:10px 12px;border-radius:10px;font-size:14px;line-height:1.6;pointer-events:none;z-index:6}\n  #cross{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);color:#fff;font-size:22px;pointer-events:none;text-shadow:0 0 6px #000;z-index:6}\n  #cross.ok{color:#ff5555}\n  #speed{position:fixed;inset:0;pointer-events:none;opacity:0;z-index:5;\n    background:repeating-conic-gradient(from 0deg at 50% 50%, transparent 0 2deg, rgba(255,255,255,.09) 2deg 3deg);\n    -webkit-mask-image:radial-gradient(circle, transparent 42%, black 78%);\n    mask-image:radial-gradient(circle, transparent 42%, black 78%);}\n  #start{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#000a;z-index:10}\n  #card{background:#111;color:#fff;padding:28px;border-radius:16px;max-width:520px;text-align:center}\n  #card button{font-size:18px;padding:12px 28px;border-radius:10px;border:0;background:#00e676;cursor:pointer;font-weight:bold}\n  #card kbd{background:#333;padding:2px 6px;border-radius:4px}\n</style>\n<script type=\"importmap\">{\"imports\":{\n  \"three\":\"./libs/three.module.js\",\n  \"three/examples/jsm/\":\"./libs/three-examples/jsm/\",\n  \"three/addons/\":\"./libs/three-examples/jsm/\",\n  \"3d-tiles-renderer\":\"./libs/package/src/index.js\",\n  \"3d-tiles-renderer/three\":\"./libs/package/src/index.js\"\n}}</script>\n<script>\nwindow.__started=false; window.__modOK=false;\nwindow.addEventListener('error',function(e){\n  var h=document.getElementById('hud');\n  if(h) h.innerHTML='エラー: '+(e.message||e.error)+'<br>F12コンソールの赤文字を教えてください';\n});\nwindow.addEventListener('DOMContentLoaded', function(){\n  function startGame(){\n    if(window.__started) return;\n    if(!window.__modOK){\n      var s=document.getElementById('loadstat');\n      if(s) s.textContent='まだ準備中…数秒待って押し直してください';\n      return;\n    }\n    document.getElementById('start').style.display='none';\n    window.__started=true;\n    var c=document.querySelector('canvas');\n    if(c && c.requestPointerLock){ try{ var r=c.requestPointerLock(); if(r&&r.catch)r.catch(function(){}); }catch(_){} }\n  }\n  document.getElementById('go').addEventListener('click', startGame);\n  document.getElementById('start').addEventListener('click', startGame);\n  window.addEventListener('keydown', function(e){\n    if(e.code==='Enter'||e.code==='Space') startGame();\n  });\n  setTimeout(function(){\n    if(!window.__modOK){\n      var ps=document.querySelectorAll('#card p');\n      var p=ps[ps.length-1];\n      if(p) p.innerHTML='<b style=\"color:#ffb\">ライブラリ読込に失敗中… 同じフォルダの libs/ が消えていないか確認してください(F12コンソールの赤文字も参照)</b>';\n    }\n  }, 8000);\n});\n</script>\n</head>\n<body>\n<div id=\"hud\"><span id=\"tp\" style=\"color:#ffd27a\">PLATEAU: 接続中…</span><br><span id=\"stat\"></span></div>\n<div id=\"speed\"></div>\n<div id=\"cross\">＋</div>\n<div id=\"start\"><div id=\"card\">\n  <h2>🕸 WebSwing Kyoto</h2>\n  <p>PLATEAU 京都市LOD2 (四条烏丸〜京都駅) を振り子スイングで滑空しよう</p>\n  <p><b>長押し</b>(クリック/スペース/タップ)＝糸＋加速、<b>離す</b>＝ジャンプ</p>\n  <p>マウス＝視点 / <kbd>A D</kbd>＝左右 / 糸は自動でも発射<br><kbd>R</kbd>＝戻る <kbd>N</kbd>＝昼夜 <kbd>M</kbd>＝オート切替</p>\n  <button id=\"go\">スイング開始</button>\n  <p id=\"loadstat\" style=\"color:#ffb\">ライブラリ読み込み中…</p>\n  <p style=\"font-size:12px;opacity:.7\">※初回は3D Tiles取得に10〜20秒かかります。重い時はURLを下京区のみに変更</p>\n</div></div>\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { TilesRenderer } from '3d-tiles-renderer/three';\nimport { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';\nimport { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\nwindow.__modOK = true;\n{ var s=document.getElementById('loadstat'); if(s){ s.style.color='#8f8'; s.textContent='準備OK！ボタンを押してね'; } }\n\n// ===== 0. 基本セットアップ =====\nconst renderer = new THREE.WebGLRenderer({antialias:true, logarithmicDepthBuffer:true});\nrenderer.setSize(innerWidth, innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x060a18);\nscene.fog = new THREE.Fog(0x060a18, 400, 3500);\nconst camera = new THREE.PerspectiveCamera(65, innerWidth/innerHeight, 1, 2000000);\naddEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\n\nfunction lonLatToEcef(latD, lonD, h=0){\n  const a=6378137, e2=6.69437999014e-3;\n  const lat=THREE.MathUtils.degToRad(latD), lon=THREE.MathUtils.degToRad(lonD);\n  const N=a/Math.sqrt(1-e2*Math.sin(lat)**2);\n  return new THREE.Vector3((N+h)*Math.cos(lat)*Math.cos(lon),(N+h)*Math.cos(lat)*Math.sin(lon),(N*(1-e2)+h)*Math.sin(lat));\n}\n// 四条烏丸〜京都駅エリア\nconst ORIGIN = lonLatToEcef(34.994, 135.758, 0);\nconst UP = ORIGIN.clone().normalize();\ncamera.up.copy(UP);\n\nconst hemi = new THREE.HemisphereLight(0x8fb0ff, 0x0a0c18, 0.5);\nscene.add(hemi);\nconst sun = new THREE.DirectionalLight(0x8fb0ff, 0.7);\nsun.position.copy(ORIGIN.clone().add(UP.clone().multiplyScalar(2000)));\nscene.add(sun);\nconst ground = new THREE.Mesh(new THREE.CircleGeometry(4000,32), new THREE.MeshStandardMaterial({color:0x14171e, roughness:1}));\nground.position.copy(ORIGIN);\nground.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1), UP);\nscene.add(ground);\n\n// ===== 1. PLATEAU 3D Tiles (localhost経由で中継: 下京区=京都駅 / 中京区=四条烏丸) =====\nconst WARD_URLS = [\n  '/cms/assets/f0/2ed501-5480-4ccb-8293-9469a3856f9a/26100_kyoto-shi_city_2025_citygml_1_op_bldg_3dtiles_26106_shimogyo-ku_lod2/tileset.json',\n  '/cms/assets/04/eaac56-936e-49e2-a91b-0db31a6ed192/26100_kyoto-shi_city_2025_citygml_1_op_bldg_3dtiles_26104_nakagyo-ku_lod2/tileset.json'\n];\nconst wardUrls = new URLSearchParams(location.search).has('ward') ? [WARD_URLS[0]] : WARD_URLS;\nlet tilesReady = false, fallbackDone = false, tileCount = 0;\nfunction tpMsg(s){ const el=document.getElementById('tp'); if(el) el.textContent=s; }\n// PLATEAU 2025 LOD2はDraco圧縮 → デコーダを登録\nconst dracoLoader = new DRACOLoader();\ndracoLoader.setDecoderPath('./libs/draco/');\nconst gltfLoader = new GLTFLoader();\ngltfLoader.setDRACOLoader(dracoLoader);\nconst tilesList = wardUrls.map(u=>{\n  const t = new TilesRenderer(u);\n  t.manager.addHandler(/\\.gltf$/, gltfLoader);\n  t.setCamera(camera);\n  t.setResolutionFromRenderer(camera, renderer);\n  scene.add(t.group);\n  t.addEventListener('load-content', ()=>{ tilesReady = true; tileCount++; tpMsg(`PLATEAU: 建物 ${tileCount}件取得`); });\n  t.addEventListener('load-error', ()=>{ tpMsg('PLATEAU: 接続エラー中…'); ensureFallback('(PLATEAU接続失敗→フォールバック街)'); });\n  return t;\n});\nfunction ensureFallback(msg){\n  if(fallbackDone || tilesReady) return;\n  fallbackDone = true; buildFallbackCity();\n  document.getElementById('stat').textContent = msg || '(フォールバック街でプレイ中)';\n  if(msg) tpMsg('PLATEAU: 未取得 ' + msg);\n}\n// 12秒経っても来なければダミービルで遊べるようにする\nsetTimeout(()=>ensureFallback('(フォールバック街でプレイ中)'), 12000);\n\nfunction buildFallbackCity(){\n  const mat = facadeMat();\n  for(let i=0;i<120;i++){\n    const w=15+Math.random()*25, h=20+Math.random()*80, d=15+Math.random()*25;\n    const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);\n    const along=(i-60)*45, side=(Math.random()<.5?-1:1)*(60+Math.random()*120);\n    // 四条通に沿って配置 (ECEF近似: 東西・南北ベクトルでオフセット)\n    const east=new THREE.Vector3().crossVectors(new THREE.Vector3(0,0,1),UP).normalize();\n    const north=new THREE.Vector3().crossVectors(UP,east).normalize();\n    m.position.copy(ORIGIN).addScaledVector(east,side).addScaledVector(north,along).addScaledVector(UP,h/2);\n    m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),UP);\n    scene.add(m);\n  }\n}\n\n// ===== 1b. 夜景ドレスアップ =====\nconst eastA=new THREE.Vector3().crossVectors(new THREE.Vector3(0,0,1),UP).normalize();\nconst northA=new THREE.Vector3().crossVectors(UP,eastA).normalize();\nlet night=true;\n\nlet _facMat=null;\nfunction facadeMat(){\n  if(_facMat) return _facMat;\n  const c=document.createElement('canvas'); c.width=128; c.height=256;\n  const x=c.getContext('2d');\n  x.fillStyle='#1b1f27'; x.fillRect(0,0,128,256);\n  for(let iy=0;iy<14;iy++)for(let ix=0;ix<6;ix++){\n    const lit=Math.random()<0.45;\n    x.fillStyle=lit?(Math.random()<0.7?'#ffd27a':'#bfe3ff'):'#0e1118';\n    x.fillRect(6+ix*20,8+iy*17,12,10);\n  }\n  const tex=new THREE.CanvasTexture(c); tex.colorSpace=THREE.SRGBColorSpace;\n  _facMat=new THREE.MeshStandardMaterial({map:tex,emissiveMap:tex,emissive:0xffc98a,emissiveIntensity:0.6,roughness:.9});\n  return _facMat;\n}\n\n// 星・月\nconst starGeo=new THREE.BufferGeometry();\n{ const n=700, arr=new Float32Array(n*3), v=new THREE.Vector3();\n  for(let i=0;i<n;i++){ v.randomDirection().multiplyScalar(60000).add(ORIGIN); arr[i*3]=v.x; arr[i*3+1]=v.y; arr[i*3+2]=v.z; }\n  starGeo.setAttribute('position',new THREE.BufferAttribute(arr,3)); }\nconst stars=new THREE.Points(starGeo,new THREE.PointsMaterial({color:0xbcd0ff,size:1.6,sizeAttenuation:false,fog:false,transparent:true,opacity:.9}));\nstars.frustumCulled=false; scene.add(stars);\nconst moon=new THREE.Mesh(new THREE.CircleGeometry(1500,32),new THREE.MeshBasicMaterial({color:0xdfe8ff,fog:false}));\nmoon.position.copy(ORIGIN).addScaledVector(eastA,35000).addScaledVector(UP,22000);\nmoon.lookAt(ORIGIN); scene.add(moon);\n\n// ネオン看板 (四条通沿い)\nfunction neonTex(text,color){\n  const c=document.createElement('canvas'); c.width=256; c.height=512;\n  const x=c.getContext('2d');\n  x.fillStyle='#07070f'; x.fillRect(0,0,256,512);\n  x.strokeStyle=color; x.lineWidth=6; x.shadowColor=color; x.shadowBlur=25;\n  x.strokeRect(14,14,228,484);\n  x.fillStyle='#fff'; x.font='bold 84px sans-serif'; x.textAlign='center'; x.textBaseline='middle';\n  const chs=[...text], n=chs.length;\n  chs.forEach((ch,i)=>x.fillText(ch,128,n>1?90+340*i/(n-1):256));\n  const t=new THREE.CanvasTexture(c); t.colorSpace=THREE.SRGBColorSpace; return t;\n}\nconst NEON=[['KYOTO','#ff2fb3'],['四条','#22e6ff'],['ラーメン','#ffb02e'],['HOTEL','#ff4040'],['カラオケ','#7cff4f'],['京都','#ff2fb3'],['SPIDER','#22e6ff'],['ネオン','#ffb02e']];\nconst poleM=new THREE.MeshStandardMaterial({color:0x14161c,roughness:.8});\nNEON.forEach((e,i)=>{\n  const s=i%2?1:-1, along=-560+i*160;\n  const m=new THREE.Mesh(new THREE.PlaneGeometry(9,18),\n    new THREE.MeshBasicMaterial({map:neonTex(e[0],e[1]),side:THREE.DoubleSide,toneMapped:false}));\n  m.position.copy(ORIGIN).addScaledVector(eastA,s*22).addScaledVector(northA,along).addScaledVector(UP,20);\n  m.up.copy(UP); m.lookAt(m.position.clone().addScaledVector(eastA,-s));\n  scene.add(m);\n  const pole=new THREE.Mesh(new THREE.CylinderGeometry(0.3,0.3,20,6),poleM);\n  pole.position.copy(m.position).addScaledVector(UP,-14);\n  pole.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),UP);\n  scene.add(pole);\n});\n\n// 街灯\nconst lampHeadM=new THREE.MeshBasicMaterial({color:0xffd9a0,toneMapped:false});\nconst poolM=new THREE.MeshBasicMaterial({color:0xffca7a,transparent:true,opacity:0.22,blending:THREE.AdditiveBlending,depthWrite:false});\nfor(let a=-1300;a<=1300;a+=130)for(const s of [-1,1]){\n  const base=ORIGIN.clone().addScaledVector(eastA,s*13).addScaledVector(northA,a);\n  const pole=new THREE.Mesh(new THREE.CylinderGeometry(0.22,0.28,9,6),poleM);\n  pole.position.copy(base).addScaledVector(UP,4.5);\n  pole.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),UP);\n  const head=new THREE.Mesh(new THREE.SphereGeometry(0.4,10,8),lampHeadM);\n  head.position.copy(base).addScaledVector(UP,9.2);\n  const pool=new THREE.Mesh(new THREE.CircleGeometry(7,20),poolM);\n  pool.position.copy(base).addScaledVector(UP,0.4);\n  pool.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1),UP);\n  scene.add(pole,head,pool);\n}\n\n// 車 (ヘッドライト+テールランプ)\nconst cars=[];\nconst carCols=[0x18202c,0x3a3f4a,0x5a0f16,0x0f3a5a];\nfor(let i=0;i<12;i++){\n  const g=new THREE.Group();\n  const dir=i%2?1:-1, lane=(i%3-1)*4.5+dir*5;\n  const body=new THREE.Mesh(new THREE.BoxGeometry(2,1.4,4.6),\n    new THREE.MeshStandardMaterial({color:carCols[i%4],roughness:.4,metalness:.4}));\n  body.position.y=0.9; g.add(body);\n  const hl=new THREE.MeshBasicMaterial({color:0xf4fbff,toneMapped:false});\n  const tl=new THREE.MeshBasicMaterial({color:0xff2a2a,toneMapped:false});\n  for(const s of [-0.6,0.6]){\n    const h=new THREE.Mesh(new THREE.PlaneGeometry(0.5,0.35),hl); h.position.set(s,0.9,2.32); g.add(h);\n    const t=new THREE.Mesh(new THREE.PlaneGeometry(0.5,0.35),tl); t.position.set(s,0.9,-2.32); t.rotation.y=Math.PI; g.add(t);\n  }\n  g.position.copy(ORIGIN).addScaledVector(eastA,lane).addScaledVector(northA,-1300+Math.random()*2600).addScaledVector(UP,0.2);\n  g.up.copy(UP); g.lookAt(g.position.clone().addScaledVector(northA,dir));\n  scene.add(g);\n  cars.push({g,dir,speed:9+Math.random()*8});\n}\n\n// 風パーティクル (速度で可視化)\nconst WIND_N=350;\nconst windGeo=new THREE.BufferGeometry();\n{ const arr=new Float32Array(WIND_N*3), c0=ORIGIN.clone().addScaledVector(UP,130);\n  for(let i=0;i<WIND_N;i++){ arr[i*3]=c0.x+(Math.random()-0.5)*90; arr[i*3+1]=c0.y+(Math.random()-0.5)*90; arr[i*3+2]=c0.z+(Math.random()-0.5)*90; }\n  windGeo.setAttribute('position',new THREE.BufferAttribute(arr,3)); }\nconst wind=new THREE.Points(windGeo,new THREE.PointsMaterial({color:0xcfe6ff,size:0.55,transparent:true,opacity:0,depthWrite:false,blending:THREE.AdditiveBlending}));\nwind.frustumCulled=false; scene.add(wind);\n\nconst _t1=new THREE.Vector3(), _sh=new THREE.Vector3();\nconst speedEl=document.getElementById('speed');\nfunction updateStreet(dt){\n  for(const c of cars){\n    c.g.position.addScaledVector(northA,c.dir*c.speed*dt);\n    const along=c.g.position.clone().sub(ORIGIN).dot(northA);\n    if(along>1350||along<-1350) c.g.position.addScaledVector(northA,-Math.sign(along)*2700);\n  }\n  const sp=P.vel.length(), wm=wind.material;\n  if((!started&&!window.__started)||sp<8){ wm.opacity=Math.max(0,wm.opacity-dt*2); return; }\n  wm.opacity=Math.min(0.7,(sp-8)/50);\n  const f0=viewDir(), arr=windGeo.attributes.position.array;\n  _t1.copy(P.vel).multiplyScalar(dt*0.9);\n  for(let i=0;i<WIND_N;i++){\n    const j=i*3;\n    arr[j]-=_t1.x; arr[j+1]-=_t1.y; arr[j+2]-=_t1.z;\n    const dx=arr[j]-P.pos.x, dy=arr[j+1]-P.pos.y, dz=arr[j+2]-P.pos.z;\n    if(dx*dx+dy*dy+dz*dz>45*45){\n      const r=15+Math.random()*25;\n      arr[j]=P.pos.x+f0.x*r+(Math.random()-0.5)*30;\n      arr[j+1]=P.pos.y+f0.y*r+(Math.random()-0.5)*30;\n      arr[j+2]=P.pos.z+f0.z*r+(Math.random()-0.5)*30;\n    }\n  }\n  windGeo.attributes.position.needsUpdate=true;\n}\n\nfunction applyMode(){\n  scene.background.set(night?0x060a18:0x87ceeb);\n  scene.fog.color.set(night?0x060a18:0x87ceeb);\n  hemi.intensity=night?0.5:1.3; sun.intensity=night?0.7:1.6;\n  sun.color.set(night?0x8fb0ff:0xffffff);\n  stars.visible=night; moon.visible=night;\n  ground.material.color.set(night?0x14171e:0x2f3336);\n}\napplyMode();\n\n// ===== 2. プレイヤー + スイング物理 =====\nconst SPAWN = lonLatToEcef(34.9965, 135.7585, 130); // 四条烏丸上空\nconst P = { pos:SPAWN.clone(), vel:new THREE.Vector3(), attached:false, anchor:new THREE.Vector3(), ropeLen:0 };\nconst GRAV=26, MAX_ROPE=260, MIN_H=2;\nconst ray = new THREE.Raycaster(); ray.far=800;\nif('firstHitOnly' in ray) ray.firstHitOnly = true;\n\nconst suitM=new THREE.MeshStandardMaterial({color:0x7d0d1d,roughness:.55,metalness:.1});\nconst darkM=new THREE.MeshStandardMaterial({color:0x15151c,roughness:.6});\nconst eyeM=new THREE.MeshBasicMaterial({color:0xf2f6ff});\nfunction limb(r,len,mat){\n  const g=new THREE.Group();\n  const m=new THREE.Mesh(new THREE.CapsuleGeometry(r,len,4,10),mat);\n  m.position.y=-(len/2+r);\n  g.add(m); return g;\n}\nconst hero=new THREE.Group(); hero.up.copy(UP);\nconst torsoH=new THREE.Mesh(new THREE.CapsuleGeometry(0.32,0.62,4,12),suitM);\ntorsoH.position.y=0.55; hero.add(torsoH);\nconst headH=new THREE.Mesh(new THREE.SphereGeometry(0.26,18,14),darkM);\nheadH.position.y=1.28; hero.add(headH);\nfor(const s of [-1,1]){\n  const eye=new THREE.Mesh(new THREE.SphereGeometry(0.09,10,8),eyeM);\n  eye.scale.set(1,1.4,0.5); eye.position.set(s*0.11,1.32,0.21); hero.add(eye);\n}\nconst armR=new THREE.Group(), armL=new THREE.Group();\narmR.position.set(0.44,0.98,0); armL.position.set(-0.44,0.98,0);\narmR.add(limb(0.11,0.5,suitM)); armL.add(limb(0.11,0.5,suitM));\nhero.add(armR,armL);\nconst legR=new THREE.Group(), legL=new THREE.Group();\nlegR.position.set(0.17,0.12,0); legL.position.set(-0.17,0.12,0);\nlegR.add(limb(0.13,0.55,darkM)); legL.add(limb(0.13,0.55,darkM));\nhero.add(legR,legL);\nscene.add(hero);\nfunction poseHero(mode){\n  if(mode==='swing'){ armR.rotation.set(-2.25,0,-0.15); armL.rotation.set(0.9,0,0.9); legR.rotation.set(0.55,0,0.12); legL.rotation.set(0.75,0,-0.12); }\n  else if(mode==='dive'){ armR.rotation.set(1.5,0,-0.25); armL.rotation.set(1.5,0,0.25); legR.rotation.set(0.15,0,0.05); legL.rotation.set(0.15,0,-0.05); }\n  else { armR.rotation.set(0.3,0,-1.15); armL.rotation.set(0.3,0,1.15); legR.rotation.set(0.35,0,0.18); legL.rotation.set(0.45,0,-0.18); }\n}\nposeHero('cruise');\nconst ropeLine = new THREE.Line(new THREE.BufferGeometry().setFromPoints([P.pos,P.pos]), new THREE.LineBasicMaterial({color:0xffffff}));\nropeLine.visible=false; scene.add(ropeLine);\nconst anchorBall = new THREE.Mesh(new THREE.SphereGeometry(1.8,14,14), new THREE.MeshBasicMaterial({color:0xff3344}));\nanchorBall.visible=false; scene.add(anchorBall);\n\n// 視点 yaw/pitch (ポインターロックで操作)\nlet yaw=Math.PI, pitch=-0.15;\nlet holdReel=false, holdTimer=0, autoMode=true, autoTimer=0;\nconst keys={};\naddEventListener('keydown',e=>{keys[e.code]=true; if(e.code==='Space'){ if(!e.repeat){holdReel=true; holdTimer=0; shoot();} e.preventDefault();} if(e.code==='KeyR')respawn(); if(e.code==='KeyN'){night=!night;applyMode();} if(e.code==='KeyM'){autoMode=!autoMode;}});\naddEventListener('keyup',e=>{keys[e.code]=false; if(e.code==='Space'){holdReel=false; detach();}});\naddEventListener('contextmenu',e=>e.preventDefault());\n\nfunction viewDir(){\n  const east=new THREE.Vector3().crossVectors(new THREE.Vector3(0,0,1),UP).normalize();\n  const north=new THREE.Vector3().crossVectors(UP,east).normalize();\n  return north.clone().multiplyScalar(Math.cos(pitch)*Math.cos(yaw))\n    .addScaledVector(east, Math.cos(pitch)*Math.sin(yaw))\n    .addScaledVector(UP, Math.sin(pitch)).normalize();\n}\nfunction tryAttach(h){\n  if(!h) return false;\n  const upDist = h.point.clone().sub(P.pos).dot(UP);\n  if(h.distance < MAX_ROPE && upDist > 3){\n    P.attached=true; P.anchor.copy(h.point); P.ropeLen=Math.min(h.distance,MAX_ROPE);\n    anchorBall.visible=true; anchorBall.position.copy(h.point);\n    ropeLine.visible=true;\n    return true;\n  }\n  return false;\n}\nfunction nearestHit(){\n  let h = null;\n  for(const t of tilesList){\n    const hits = ray.intersectObject(t.group, true);\n    if(hits.length && (!h || hits[0].distance < h.distance)) h = hits[0];\n  }\n  if(!h){\n    // フォールバック街や地面にも引っ掛けられるように全シーンで再試行\n    const hits2 = ray.intersectObjects(scene.children.filter(o=>o!==ropeLine&&o!==anchorBall&&o!==hero), true);\n    if(hits2.length) h = hits2[0];\n  }\n  return h;\n}\nfunction shoot(){\n  ray.setFromCamera(new THREE.Vector2(0,0), camera);\n  tryAttach(nearestHit());\n}\nfunction autoShoot(fwd){\n  _t1.copy(P.pos).addScaledVector(fwd,60).addScaledVector(UP,30);\n  ray.set(P.pos,_t1.sub(P.pos).normalize());\n  tryAttach(nearestHit());\n}\nfunction detach(boost=1.6){\n  if(!P.attached) return;\n  P.attached=false; anchorBall.visible=false; ropeLine.visible=false;\n  P.vel.multiplyScalar(boost).addScaledVector(UP,12);\n}\nfunction respawn(){ P.pos.copy(SPAWN); P.vel.set(0,0,0); detach(); P.attached=false; ropeLine.visible=false; anchorBall.visible=false; }\naddEventListener('pointerdown',e=>{ if((!started&&!window.__started)||e.target.closest('#card'))return; if(e.button===2){detach();} else if(e.button===0){ holdReel=true; holdTimer=0; shoot(); } });\naddEventListener('pointerup',e=>{ if(e.button===0){ holdReel=false; detach(); } });\n// タッチ: 長押し=糸+加速、離す=ジャンプ、ドラッグ=視点\nlet lastTX=0;\naddEventListener('touchstart',e=>{ if(!started&&!window.__started) return; holdReel=true; holdTimer=0; shoot(); lastTX=e.touches[0].clientX; },{passive:true});\naddEventListener('touchmove',e=>{ if(!started&&!window.__started) return; const x=e.touches[0].clientX; yaw-=(x-lastTX)*0.005; lastTX=x; },{passive:true});\naddEventListener('touchend',()=>{ holdReel=false; detach(); });\naddEventListener('mousemove',e=>{\n  if(!document.pointerLockElement) return;\n  yaw -= e.movementX*0.0022; pitch -= e.movementY*0.0022;\n  pitch = THREE.MathUtils.clamp(pitch,-1.2,1.2);\n});\n\nfunction stepPlayer(dt){\n  const fwd = viewDir();\n  const sp = P.vel.length();\n  P.vel.addScaledVector(UP,-GRAV*dt);\n  P.vel.multiplyScalar(Math.max(0,1-0.04*dt));\n  const right=new THREE.Vector3().crossVectors(fwd,UP).normalize();\n  if(P.attached && keys['KeyW']) P.ropeLen=Math.max(12,P.ropeLen-16*dt);\n  if(P.attached && keys['KeyS']) P.ropeLen=Math.min(MAX_ROPE,P.ropeLen+16*dt);\n  if(keys['KeyW']&&!P.attached) P.vel.addScaledVector(fwd,60*dt);\n  if(keys['KeyS']&&!P.attached) P.vel.addScaledVector(fwd,-10*dt);\n  if(keys['KeyA']) P.vel.addScaledVector(right,-40*dt);\n  if(keys['KeyD']) P.vel.addScaledVector(right,40*dt);\n  if(!P.attached && fwd.dot(UP) < -0.25) P.vel.addScaledVector(fwd,(keys['KeyW']?90:20)*dt); // ダイブ加速\n  P.pos.addScaledVector(P.vel,dt);\n  const hAbove=P.pos.clone().sub(ORIGIN).dot(UP);\n\n  // 長押し=巻取り / オート=勝手に糸を掛け直す\n  if(holdReel){\n    if(P.attached) P.ropeLen=Math.max(10,P.ropeLen-30*dt);\n    else { holdTimer-=dt; if(holdTimer<=0){ holdTimer=0.15; shoot(); } }\n  }\n  autoTimer-=dt;\n  if(autoMode && !P.attached && !holdReel && hAbove>8 && sp>4 && autoTimer<=0){ autoTimer=0.4; autoShoot(fwd); }\n\n  if(P.attached){\n    const d=P.pos.clone().sub(P.anchor); const dist=d.length();\n    if(dist>P.ropeLen){\n      const n=d.divideScalar(dist||1);\n      P.pos.copy(P.anchor).addScaledVector(n,P.ropeLen);\n      const vOut=P.vel.dot(n);\n      if(vOut>0) P.vel.addScaledVector(n,-vOut);\n      P.vel.addScaledVector(fwd,22*dt); // ポンプ加速\n    }\n    if(P.pos.distanceTo(P.anchor)>MAX_ROPE*1.2) detach(1);\n  }\n  if(hAbove<MIN_H){ P.pos.addScaledVector(UP,MIN_H-hAbove);\n    const vUp=P.vel.dot(UP); if(vUp<0)P.vel.addScaledVector(UP,-vUp*1.6); P.vel.multiplyScalar(0.96); }\n  // ヒーロー向き・ポーズ\n  hero.position.copy(P.pos);\n  if(sp>2){ _t1.copy(P.pos).add(P.vel); hero.lookAt(_t1); }\n  poseHero(P.attached?'swing':(sp>20&&fwd.dot(UP)<-0.25)?'dive':'cruise');\n  if(P.attached){ _t1.copy(P.pos).addScaledVector(UP,1.15); ropeLine.geometry.setFromPoints([_t1,P.anchor]); }\n\n  // カメラ追従 + FOV演出 + 振動\n  const want=P.pos.clone().addScaledVector(fwd,-7).addScaledVector(UP,3);\n  camera.position.lerp(want,1-Math.pow(0.0005,dt));\n  _sh.copy(P.pos).addScaledVector(fwd,14).addScaledVector(P.vel,0.2);\n  const shk=Math.min(1,sp/55)*0.4;\n  if(shk>0.01){ _sh.addScaledVector(right,(Math.random()-0.5)*shk).addScaledVector(UP,(Math.random()-0.5)*shk); }\n  camera.lookAt(_sh);\n  speedEl.style.opacity=THREE.MathUtils.clamp((sp-16)/45,0,0.85).toFixed(2);\n  const tFov=THREE.MathUtils.clamp(62+sp*0.7,62,100);\n  camera.fov+=(tFov-camera.fov)*Math.min(1,dt*4); camera.updateProjectionMatrix();\n  // HUD + 照準色\n  const kmh=Math.round(sp*3.6);\n  document.getElementById('stat').textContent=`速度 ${kmh}km/h 高度 ${Math.round(hAbove)}m ${P.attached?('ロープ '+Math.round(P.ropeLen)+'m'):'送電線なし — ビルを狙ってクリック'}`;\n  document.getElementById('cross').className = P.attached?'ok':'';\n}\n\n// 照準アシスト: 中央にビルがあれば照準を赤く\nlet started=false;\nfunction hideStartHint(){}\ndocument.getElementById('go').onclick=()=>{\n  document.getElementById('start').style.display='none';\n  started=true; window.__started=true; renderer.domElement.requestPointerLock?.();\n  camera.position.copy(P.pos.clone().addScaledVector(viewDir(),-10).addScaledVector(UP,4));\n};\nrenderer.domElement.addEventListener('click',()=>{ if(started) renderer.domElement.requestPointerLock?.(); });\n\nconst clock=new THREE.Clock();\n(function loop(){\n  requestAnimationFrame(loop);\n  const dt=Math.min(clock.getDelta(),0.05);\n  for(const t of tilesList){\n    t.setCamera(camera); t.setResolutionFromRenderer(camera,renderer);\n    camera.updateMatrixWorld(); t.update();\n  }\n  if(started||window.__started) stepPlayer(dt);\n  else { // 開始前は京都駅をゆっくり周回\n    const t=performance.now()*0.0001;\n    camera.position.copy(lonLatToEcef(34.99+t*0.002%0.02,135.758,300));\n    camera.lookAt(lonLatToEcef(34.994,135.758,50));\n  }\n  updateStreet(dt);\n  // 照準チェック (1秒に5回だけ)\n  renderer.render(scene,camera);\n})();\n</script>\n</body>\n</html>",
