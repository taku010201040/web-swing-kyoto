            "input": {
              "content": "import * as THREE from 'three';\n\nexport class Ninja {\n  readonly group = new THREE.Group();\n  private armR: THREE.Group;\n  private armL: THREE.Group;\n  private legR: THREE.Group;\n  private legL: THREE.Group;\n  private torso: THREE.Mesh;\n  private scarf: THREE.Mesh;\n  private scarfSegs = 10;\n  private scarfPts: THREE.Vector3[];\n\n  constructor() {\n    const suit = new THREE.MeshStandardMaterial({ color: 0x7d0d1d, roughness: 0.55, metalness: 0.08 });\n    const dark = new THREE.MeshStandardMaterial({ color: 0x15151c, roughness: 0.6 });\n    const eyeM = new THREE.MeshBasicMaterial({ color: 0xf2f6ff });\n\n    this.torso = new THREE.Mesh(new THREE.CapsuleGeometry(0.3, 0.6, 4, 12), suit);\n    this.torso.position.y = 0.62;\n    this.group.add(this.torso);\n\n    const head = new THREE.Mesh(new THREE.SphereGeometry(0.25, 18, 14), dark);\n    head.position.y = 1.32;\n    this.group.add(head);\n    for (const s of [-1, 1]) {\n      const eye = new THREE.Mesh(new THREE.SphereGeometry(0.085, 10, 8), eyeM);\n      eye.scale.set(1, 1.4, 0.5);\n      eye.position.set(s * 0.1, 1.35, 0.2);\n      this.group.add(eye);\n    }\n    const band = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.1, 0.5), suit);\n    band.position.y = 1.46;\n    this.group.add(band);\n\n    this.armR = limb(0.1, 0.48, suit, 0.42, 1.06);\n    this.armL = limb(-0.42, 1.06, 0.1, 0.48, suit);\n    this.legR = limb(0.16, 0.12, 0.12, 0.52, dark);\n    this.legL = limb(-0.16, 0.12, 0.12, 0.52, dark);\n    this.group.add(this.armR, this.armL, this.legR, this.legL);\n    this.armR.position.set(0.42, 1.06, 0);\n    this.armL.position.set(-0.42, 1.06, 0);\n    this.legR.position.set(0.16, 0.12, 0);\n    this.legL.position.set(-0.16, 0.12, 0);\n\n    this.scarfPts = [];\n    for (let i = 0; i < this.scarfSegs; i++) this.scarfPts.push(new THREE.Vector3(0, 1.5, 0));\n    const scarfGeo = new THREE.BufferGeometry();\n    const pos = new Float32Array((this.scarfSegs - 1) * 6);\n    const uv = new Float32Array((this.scarfSegs - 1) * 6);\n    const idx: number[] = [];\n    for (let i = 0; i < this.scarfSegs - 1; i++) {\n      uv[i * 6] = 0; uv[i * 6 + 1] = i / (this.scarfSegs - 1);\n      uv[i * 6 + 2] = 1; uv[i * 6 + 3] = i / (this.scarfSegs - 1);\n      uv[i * 6 + 4] = 0; uv[i * 6 + 5] = (i + 1) / (this.scarfSegs - 1);\n      idx.push(i * 4, i * 4 + 2, i * 4 + 1, i * 4 + 1, i * 4 + 2, i * 4 + 3);\n    }\n    scarfGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n    scarfGeo.setAttribute('uv', new THREE.BufferAttribute(uv, 2));\n    scarfGeo.setIndex(idx);\n    this.scarf = new THREE.Mesh(\n      scarfGeo,\n      new THREE.MeshBasicMaterial({ color: 0xe8ecf4, side: THREE.DoubleSide }),\n    );\n    this.scarf.frustumCulled = false;\n    this.group.add(this.scarf);\n    this.pose('cruise');\n  }\n\n  pose(mode: 'swing' | 'dive' | 'cruise' | 'fall'): void {\n    if (mode === 'swing') {\n      this.armR.rotation.set(-2.3, 0, -0.15);\n      this.armL.rotation.set(0.85, 0, 0.75);\n      this.legR.rotation.set(0.5, 0, 0.1);\n      this.legL.rotation.set(0.72, 0, -0.1);\n    } else if (mode === 'dive') {\n      this.armR.rotation.set(1.55, 0, -0.25);\n      this.armL.rotation.set(1.55, 0, 0.25);\n      this.legR.rotation.set(0.12, 0, 0.05);\n      this.legL.rotation.set(0.12, 0, -0.05);\n    } else if (mode === 'fall') {\n      this.armR.rotation.set(0.4, 0, -1.5);\n      this.armL.rotation.set(0.4, 0, 1.5);\n      this.legR.rotation.set(0.3, 0, 0.2);\n      this.legL.rotation.set(0.5, 0, -0.2);\n    } else {\n      this.armR.rotation.set(0.3, 0, -1.15);\n      this.armL.rotation.set(0.3, 0, 1.15);\n      this.legR.rotation.set(0.35, 0, 0.18);\n      this.legL.rotation.set(0.45, 0, -0.18);\n    }\n  }\n\n  updateScarf(dt: number, velocity: THREE.Vector3, parent: THREE.Object3D): void {\n    const head = this.scarfPts[0];\n    this.group.localToWorld(head.set(0, 1.45, -0.25));\n    parent.worldToLocal(head);\n    const drag = velocity.clone().multiplyScalar(dt * 0.55);\n    for (let i = 1; i < this.scarfSegs; i++) {\n      const p = this.scarfPts[i];\n      const prev = this.scarfPts[i - 1];\n      p.add(drag);\n      p.y -= 2.2 * dt;\n      const d = p.clone().sub(prev);\n      const len = d.length();\n      const target = 0.42;\n      if (len > target) p.copy(prev).addScaledVector(d.multiplyScalar(1 / len), target);\n    }\n    const posAttr = this.scarf.geometry.getAttribute('position') as THREE.BufferAttribute;\n    const arr = posAttr.array as Float32Array;\n    const w = 0.22;\n    const dir = new THREE.Vector3();\n    const side = new THREE.Vector3();\n    for (let i = 0; i < this.scarfSegs - 1; i++) {\n      const a = this.scarfPts[i];\n      const b = this.scarfPts[i + 1];\n      dir.subVectors(b, a).normalize();\n      side.set(0, 1, 0).cross(dir).normalize().multiplyScalar(w);\n      arr.set([a.x + side.x, a.y + side.y, a.z + side.z, a.x - side.x, a.y - side.y, a.z - side.z, b.x - side.x, b.y - side.y, b.z - side.z], i * 6);\n    }\n    posAttr.needsUpdate = true;\n    this.scarf.geometry.computeVertexNormals();\n  }\n}\n\nfunction limb(x: number, y: number, z: number, w: number, h: number, mat: THREE.Material): THREE.Group {\n  const g = new THREE.Group();\n  const m = new THREE.Mesh(new THREE.CapsuleGeometry(z, h, 4, 10), mat);\n  m.position.y = w;\n  g.add(m);\n  g.position.set(x, y, w);\n  return g;\n}\n",
