"loadstat\" style=\"color:#ffb\">ライブラリ読み込み中…</p>\n74:   <p style=\"font-size:12px;opacity:.7\">※初回は3D Tiles取得に10〜20秒かかります。重い時はURLを下京区のみに変更</p>\n75: </div></div>\n76: <script type=\"module\">\n77: import * as THREE from 'three';\n78: import { TilesRenderer } from '3d-tiles-renderer/three';\n79: import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';\n80: import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\n81: window.__modOK = true;\n82: { var s=document.getElementById('loadstat'); if(s){ s.style.color='#8f8'; s.textContent='準備OK！ボタンを押してね'; } }\n83: \n84: // ===== 0. 基本セットアップ =====\n85: const renderer = new THREE.WebGLRenderer({antialias:true, logarithmicDepthBuffer:true});\n86: renderer.setSize(innerWidth, innerHeight);\n87: document.body.appendChild(renderer.domElement);\n88: const scene = new THREE.Scene();\n89: scene.background = new THREE.Color(0x060a18);\n90: scene.fog = new THREE.Fog(0x060a18, 400, 3500);\n91: const camera = new THREE.PerspectiveCamera(65, innerWidth/innerHeight, 1, 2000000);\n92: addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\n93: \n94: function lonLatToEcef(latD, lonD, h=0){\n95:   const a=6378137, e2=6.69437999014e-3;\n96:   const lat=THREE.MathUtils.degToRad(latD), lon=THREE.MathUtils.degToRad(lonD);\n97:   const N=a/Math.sqrt(1-e2*Math.sin(lat)**2);\n98:   return new THREE.Vector3((N+h)*Math.cos(lat)*Math.cos(lon),(N+h)*Math.cos(lat)*Math.sin(lon),(N*(1-e2)+h)*Math.sin(lat));\n99: }\n100: // 四条烏丸〜京都駅エリア\n101: const ORIGIN = lonLatToEcef(34.994, 135.758, 0);\n102: const UP = ORIGIN.clone().normalize();\n103: camera.up.copy(UP);\n104: \n105: const hemi = new THREE.HemisphereLight(0x8fb0ff, 0x0a0c18, 0.5);\n106: scene.add(hemi);\n107: const sun = new THREE.DirectionalLight(0x8fb0ff, 0.7);\n108: sun.position.copy(ORIGIN.clone().add(UP.clone().multiplyScalar(2000)));\n109: scene.add(sun);\n110: const ground = new THREE.Mesh(new THREE.CircleGeometry(4000,32), new THREE.MeshStandardMaterial({color:0x14171e, roughness:1}));\n111: ground.position.copy(ORIGIN);\n112: ground.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1), UP);\n113: scene.add(ground);\n114: \n115: // ===== 1. PLATEAU 3D Tiles (localhost経由で中継: 下京区=京都駅 / 中京区=四条烏丸) =====\n116: const WARD_URLS = [\n117:   '/cms/assets/f0/2ed501-5480-4ccb-8293-9469a3856f9a/26100_kyoto-shi_city_2025_citygml_1_op_bldg_3dtiles_26106_shimogyo-ku_lod2/tileset.json',\n118:   '/cms/assets/04/eaac56-936e-49e2-a91b-0db31a6ed192/26100_kyoto-shi_city_2025_citygml_1_op_bldg_3dtiles_26104_nakagyo-ku_lod2/tileset.json'\n119: ];\n120: const wardUrls = new URLSearchParams(location.search).has('ward') ? [WARD_URLS[0]] : WARD_URLS;\n121: let tilesReady = false, fallbackDone = false, tileCount = 0;\n122: function tpMsg(s){ const el=document.getElementById('tp'); if(el) el.textContent=s; }\n123: // PLATEAU 2025 LOD2はDraco圧縮 → デコーダを登録\n124: const dracoLoader = new DRACOLoader();\n125: dracoLoader.setDecoderPath('./libs/draco/');\n126: const gltfLoader = new GLTFLoader();\n127: gltfLoader.setDRACOLoader(dracoLoader);\n128: const tilesList = wardUrls.map(u=>{\n129:   const t = new TilesRenderer(u);\n130:   t.manager.addHandler(/\\.gltf$/, gltfLoader);\n131:   t.setCamera(camera);\n132:   t.setResolutionFromRenderer(camera, renderer);\n133:   scene.add(t.group);\n134:   t.addEventListener('load-content', ()=>{ tilesReady = true; tileCount++; tpMsg(`PLATEAU: 建物 ${tileCount}件取得`); });\n135:   t.addEventListener('load-error', ()=>{ tpMsg('PLATEAU: 接続エラー中…'); ensureFallback('(PLATEAU接続失敗→フォールバック街)'); });\n136:   return t;\n137: });\n138: function ensureFallback(msg){\n139:   if(fallbackDone || tilesReady) return;\n140:   fallbackDone = true; buildFallbackCity();\n141:   document.getElementById('stat').textContent = msg || '(フォールバック街でプレイ中)';\n142:   if(msg) tpMsg('PLATEAU: 未取得 ' + msg);\n143: }\n144: // 12秒経っても来なければダミービルで遊べるようにする\n145: setTimeout(()=>ensureFallback('(フォールバック街でプレイ中)'), 12000);\n146: \n147: function buildFallbackCity(){\n148:   const mat = facadeMat();\n149:   for(let i=0;i<120;i++){\n150:     const w=15+Math.random()*25, h=20+Math.random()*80, d=15+Math.random()*25;\n151:     const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);\n152:     const along=(i-60)*45, side=(Math.random()<.5?-1:1)*(60+Math.random()*120);\n153:     // 四条通に沿って配置 (ECEF近似: 東西・南北ベクトルでオフセット)\n154:     const east=new THREE.Vector3().crossVectors(new THREE.Vector3(0,0,1),UP).normalize();\n155:     const north=new THREE.Vector3().crossVectors(UP,east).normalize();\n156:     m.position.copy(ORIGIN).addScaledVector(east,side).addScaledVector(north,along).addScaledVector(UP,h/2);\n157:     m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),UP);\n158:     scene.add(m);\n159:   }\n160: }\n161: \n162: // ===== 1b. 夜景ドレスアップ =====\n163: const eastA=new THREE.Vector3().crossVectors(new THREE.Vector3(0,0,1),UP).normalize();\n164: const northA=new THREE.Vector3().crossVectors(UP,eastA).normalize();\n165: let night=true;\n166: \n167: let _facMat=null;\n168: function facadeMat(){\n169:   if(_facMat) return _facMat;\n170:   const c=document.createElement('canvas'); c.width=128; c.height=256;\n171:   const x=c.getContext('2d');\n172:   x.fillStyle='#1b1f27'; x.fillRect(0,0,128,256);\n173:   for(let iy=0;iy<14;iy++)for(let ix=0;ix<6;ix++){\n174:     const lit=Math.random()<0.45;\n175:     x.fillStyle=lit?(Math.random()<0.7?'#ffd27a':'#bfe3ff'):'#0e1118';\n176:     x.fillRect(6+ix*20,8+iy*17,12,10);\n177:   }\n178:   const tex=new THREE.CanvasTexture(c); tex.colorSpace=THREE.SRGBColorSpace;\n179:   _facMat=new THREE.MeshStandardMaterial({map:tex,emissiveMap:tex,emissive:0xffc98a,emissiveIntensity:0.6,roughness:.9});\n180:   return _facMat;\n181: }\n182: \n183: // 星・月\n184: const starGeo=new THREE.BufferGeometry();\n185: { const n=700, arr=new Float32Array(n*3), v=new THREE.Vector3();\n186:   for(let i=0;i<n;i++){ v.randomDirection().multiplyScalar(60000).add(ORIGIN); arr[i*3]=v.x; arr[i*3+1]=v.y; arr[i*3+2]=v.z; }\n187:   starGeo.setAttribute('position',new THREE.BufferAttribute(arr,3)); }\n188: const stars=new THREE.Points(starGeo,new THREE.PointsMaterial({color:0xbcd0ff,size:1.6,sizeAttenuation:false,fog:false,transparent:true,opacity:.9}));\n189: stars.frustumCulled=false; scene.add(stars);\n190: const moon=new THREE.Mesh(new THREE.CircleGeometry(1500,32),new THREE.MeshBasicMaterial({color:0xdfe8ff,fog:false}));\n191: moon.position.copy(ORIGIN).addScaledVector(eastA,35000).addScaledVector(UP,22000);\n192: moon.lookAt(ORIGIN); scene.add(moon);\n193: \n194: // ネオン看板 (四条通沿い)\n195: function neonTex(text,color){\n196:   const c=document.createElement('canvas'); c.width=256; c.height=512;\n197:   const x=c.getContext('2d');\n198:   x.fillStyle='#07070f'; x.fillRect(0,0,256,512);\n199:   x.strokeStyle=color; x.lineWidth=6; x.shadowColor=color; x.shadowBlur=25;\n200:   x.strokeRect(14,14,228,484);\n201:   x.fillStyle='#fff'; x.font='bold 84px sans-serif'; x.textAlign='center'; x.textBaseline='middle';\n202:   const chs=[...text], n=chs.length;\n203:   chs.forEach((ch,i)=>x.fillText(ch,128,n>1?90+340*i/(n-1):256));\n204:   const t=new THREE.CanvasTexture(c); t.colorSpace=THREE.SRGBColorSpace; return t;\n205: }\n206: const NEON=[['KYOTO','#ff2fb3'],['四条','#22e6ff'],['ラーメン','#ffb02e'],['HOTEL','#ff4040'],['カラオケ','#7cff4f'],['京都','#ff2fb3'],['SPIDER','#22e6ff'],['ネオン','#ffb02e']];\n207: const poleM=new THREE.MeshStandardMaterial({color:0x14161c,roughness:.8});\n208: NEON.forEach((e,i)=>{\n209:   const s=i%2?1:-1, along=-560+i*160;\n210:   const m=new THREE.Mesh(new THREE.PlaneGeometry(9,18),\n211:     new THREE.MeshBasicMaterial({map:neonTex(e[0],e[1]),side:THREE.DoubleSide,toneMapped:false}));\n212:   m.position.copy(ORIGIN).addScaledVector(eastA,s*22).addScaledVector(northA,along).addScaledVector(UP,20);\n213:   m.up.copy(UP); m.lookAt(m.position.clone().addScaledVector(eastA,-s));\n214:   scene.add(m);\n215:   cons