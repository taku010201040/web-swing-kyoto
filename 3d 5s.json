        },
        {
          "id": "prt_124c4cc86001tGxasWKK9ZzHSw",
          "sessionID": "ses_edb647afeffeJQJ4rlBZM3OHV7",
          "messageID": "msg_124c41c4f001wHpkLetlZCU60F",
          "type": "tool",
          "callID": "call_0dd2b53df8cf4f4c860aabdc",
          "tool": "write",
          "state": {
            "status": "completed",
            "input": {
              "content": "const { spawn } = require('child_process');\nconst fs = require('fs');\nconst os = require('os');\nconst path = require('path');\n\nconst URL = process.argv[2] || 'http://127.0.0.1:4173/';\nconst userDataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'chrome-test-'));\n\nconst chrome = spawn('C:\\\\Program Files\\\\Google\\\\Chrome\\\\Application\\\\chrome.exe', [\n  '--headless=new',\n  '--remote-debugging-port=9222',\n  `--user-data-dir=${userDataDir}`,\n  '--no-sandbox',\n  '--disable-dev-shm-usage',\n  '--use-gl=angle',\n  '--use-angle=swiftshader',\n  '--enable-unsafe-swiftshader',\n  '--window-size=1280,720',\n  'about:blank',\n], { stdio: 'ignore' });\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n\nasync function main() {\n  let ws = null;\n  let msgId = 0;\n  const pending = new Map();\n  const logs = [];\n  const errors = [];\n  const consoleErrors = [];\n  const netErrors = [];\n\n  for (let i = 0; i < 40; i++) {\n    await sleep(500);\n    try {\n      const res = await fetch('http://127.0.0.1:9222/json/list');\n      const targets = await res.json();\n      const page = targets.find((t) => t.type === 'page');\n      if (page) { ws = page.webSocketDebuggerUrl; break; }\n    } catch {}\n  }\n  if (!ws) throw new Error('chrome devtools not reachable');\n\n  const sock = new WebSocket(ws);\n  await new Promise((res, rej) => { sock.onopen = res; sock.onerror = rej; });\n\n  sock.onmessage = (ev) => {\n    const msg = JSON.parse(ev.data);\n    if (msg.id && pending.has(msg.id)) {\n      pending.get(msg.id)(msg);\n      pending.delete(msg.id);\n    }\n    if (msg.method === 'Runtime.consoleAPICalled') {\n      const text = (msg.params.args || []).map((a) => a.value ?? a.description ?? a.type).join(' ');\n      logs.push(`[${msg.params.type}] ${text}`);\n      if (msg.params.type === 'error') consoleErrors.push(text);\n    }\n    if (msg.method === 'Runtime.exceptionThrown') {\n      errors.push(msg.params.exceptionDetails.exception?.description || msg.params.exceptionDetails.text);\n    }\n    if (msg.method === 'Log.entryAdded') {\n      const e = msg.params.entry;\n      logs.push(`[log:${e.level}] ${e.text} ${e.url || ''}`);\n      if (e.level === 'error') netErrors.push(`${e.text} ${e.url || ''}`);\n    }\n  };\n\n  const send = (method, params = {}) =>\n    new Promise((res) => {\n      const id = ++msgId;\n      pending.set(id, (m) => res(m.result));\n      sock.send(JSON.stringify({ id, method, params }));\n    });\n\n  const evaluate = async (expr) => {\n    const r = await send('Runtime.evaluate', { expression: expr, returnByValue: true, awaitPromise: true });\n    return r.result?.value;\n  };\n\n  await send('Runtime.enable');\n  await send('Log.enable');\n  await send('Page.enable');\n  await send('Network.enable');\n\n  const t0 = Date.now();\n  await send('Page.navigate', { url: URL });\n  await sleep(3000);\n\n  const titleVisible = await evaluate(`!document.getElementById('ui-title')?.classList.contains('hidden')`);\n  const loadingVisible = await evaluate(`!document.getElementById('ui-loading')?.classList.contains('hidden')`);\n  const loadText = await evaluate(`document.getElementById('load-text')?.textContent`);\n  const status = await evaluate(`document.getElementById('plateau-status')?.textContent`);\n\n  const deadline = Date.now() + 20000;\n  let started = false;\n  while (Date.now() < deadline && !started) {\n    await sleep(1000);\n    started = await evaluate(`!document.getElementById('ui-title')?.classList.contains('hidden')`);\n  }\n  const titleWaitMs = Date.now() - t0;\n\n  const started2 = await evaluate(`(() => { const b = document.getElementById('btn-start'); b?.click(); return true; })()`);\n  await sleep(4000);\n  const hudVisible = await evaluate(`!document.getElementById('hud')?.classList.contains('hidden')`);\n  const time1 = await evaluate(`document.getElementById('hud-time')?.textContent`);\n  const speed = await evaluate(`document.getElementById('hud-speed')?.textContent`);\n  const alt = await evaluate(`document.getElementById('hud-alt')?.textContent`);\n  const next = await evaluate(`document.getElementById('hud-next')?.textContent`);\n  const nextDist = await evaluate(`document.getElementById('hud-next-dist')?.textContent`);\n  const coinsTotal = await evaluate(`document.getElementById('hud-coins')?.textContent`);\n  const banner = await evaluate(`document.getElementById('banner')?.textContent`);\n\n  const canvasSize = await evaluate(`(() => { const c = document.querySelector('canvas'); return c ? c.width + 'x' + c.height : 'none'; })()`);\n\n  await sleep(3000);\n  const time2 = await evaluate(`document.getElementById('hud-time')?.textContent`);\n\n  console.log('=== RESULT ===');\n  console.log('titleVisible@3s:', titleVisible, 'loadingVisible@3s:', loadingVisible);\n  console.log('loadText:', loadText, '| plateauStatus:', status);\n  console.log('titleVisible later:', started2, 'after', titleWaitMs, 'ms');\n  console.log('hudVisible:', hudVisible, 'canvas:', canvasSize);\n  console.log('time1:', time1, 'time2:', time2, 'speed:', speed, 'alt:', alt);\n  console.log('next:', next, 'dist:', nextDist, 'coins:', coinsTotal, 'banner:', banner);\n  console.log('consoleErrors:', JSON.stringify(consoleErrors, null, 1));\n  console.log('pageErrors:', JSON.stringify(errors, null, 1));\n  console.log('netErrors:', JSON.stringify(netErrors.slice(0, 5), null, 1));\n  console.log('allLogs:', JSON.stringify(logs.slice(0, 12), null, 1));\n\n  sock.close();\n  chrome.kill();\n  await sleep(500);\n  process.exit(consoleErrors.length === 0 && errors.length === 0 ? 0 : 1);\n}\n\nmain().catch((e) => { console.error('FAILED', e); chrome.kill(); process.exit(2); });\n",
